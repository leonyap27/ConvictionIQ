# ConvictionIQ — environment variable reference
# Copy this file to .env and fill in the values you need.
# The app works fully offline without any of these set.

# ---------------------------------------------------------------------------
# TIER 1 — Cloud sync (optional)
# Needed only to enable the "Sync to Server" and "Refresh from Server"
# buttons in the header, which sync local data to Supabase so Claude can
# read it via MCP tools.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side / MCP tools (same project, service-role key for server access)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# TIER 2 — AI Q&A via MCP (optional)
# Needed only for the ask_stock MCP tool ("Ask about a stock" via Claude).
# ---------------------------------------------------------------------------
LOVABLE_API_KEY=
